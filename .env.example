# =====================================================================
# Variables de configuración — EJEMPLO con valores FICTICIOS
# Sistema SIG de Intervenciones en el Espacio Público de Cali (Taller 3)
# Copiar a .env SOLO en un ambiente local de desarrollo. En pruebas y
# producción los valores sensibles se inyectan desde el gestor de
# secretos (C15). Nunca subir un .env real al repositorio.
# Los nombres son una propuesta; deben validarse con el código real.
# =====================================================================

# --- Aplicación (C03 API REST) ---
APP_ENTORNO=desarrollo                 # desarrollo | pruebas | produccion
APP_URL_PUBLICA=https://sig-intervenciones.example.org
APP_ZONA_HORARIA=America/Bogota
APP_SRID_ALMACENAMIENTO=9377           # DE-01

# --- Base de datos (C09) ---
DB_HOST=db.example.internal
DB_PUERTO=5432
DB_NOMBRE=sigep
DB_USUARIO_APP=sigep_app_login         # cuenta con rol sigep_app (MD-01 §12)
DB_CLAVE_APP=CAMBIAR_POR_SECRETO

# --- Redis (C11) ---
REDIS_URL=redis://redis.example.internal:6379/0

# --- Almacenamiento de objetos (C10) ---
S3_ENDPOINT=https://s3.example.internal
S3_BUCKET=sigep-archivos
S3_ACCESS_KEY=CAMBIAR_POR_SECRETO
S3_SECRET_KEY=CAMBIAR_POR_SECRETO

# --- Identidad (C04 Keycloak) ---
OIDC_EMISOR=https://sig-intervenciones.example.org/auth/realms/sigep
OIDC_CLIENTE_ID=sigep-api

# --- Análisis de archivos (C08) ---
CLAMAV_HOST=clamav.example.internal
CLAMAV_PUERTO=3310
ARCHIVO_TAMANO_MAX_MB=50               # HU-03
ARCHIVOS_MAX_POR_SOLICITUD=12          # RS-10

# --- Integraciones (Taller 2, §11) ---
SMTP_HOST=smtp.example.internal
SMTP_PUERTO=587
SMTP_REMITENTE=no-responder@example.org
GESTION_DOCUMENTAL_URL=https://gd.example.internal/api
IDESC_WMS_URL=https://idesc.example.org/wms     # URL real por confirmar con IDESC (§11.6)
IDESC_WFS_URL=https://idesc.example.org/wfs
INTEGRACION_REINTENTOS=3
INTEGRACION_ESPERAS_S=15,60,180                 # Tabla 68

# --- Reglas espaciales (catálogo; valores iniciales) ---
UMBRAL_DUPLICIDAD_M=50                 # HU-08, calibración en A-06
RADIO_CONSULTA_M=100                   # HU-17
PRECISION_GPS_ADVERTENCIA_M=10         # RNF-18
