# EJEMPLO — proxy de perímetro sigep-lb01/02 (C01). Validar con la configuración real de DATIC.
worker_processes auto;
pid /run/nginx.pid;
error_log /var/log/nginx/error.log;
events { worker_connections 1024; }
http {
  access_log /var/log/nginx/access.log;
  client_max_body_size 50m;                 # HU-03: archivo máx. 50 MB
  server_tokens off;
  upstream sigep_ingress {                  # regla R1: LB -> nodos K3s, puerto 80
    server 198.51.100.11:80 max_fails=3 fail_timeout=10s;
    server 198.51.100.12:80 max_fails=3 fail_timeout=10s;
    server 198.51.100.13:80 max_fails=3 fail_timeout=10s;
  }
  server {
    listen 80;
    server_name sig-intervenciones.example.org;
    return 301 https://$host$request_uri;
  }
  server {
    listen 443 ssl http2;
    server_name sig-intervenciones.example.org;
    ssl_certificate     /etc/ssl/sigep/certificado.crt;
    ssl_certificate_key /etc/ssl/private/sigep.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    location /     { proxy_pass http://sigep_ingress; }
    location /api/ { proxy_pass http://sigep_ingress; proxy_read_timeout 60s; }
    location /auth/ { proxy_pass http://sigep_ingress; }
    location /ows  { proxy_pass http://sigep_ingress; }
    location ~ ^/(auth/admin|geoserver/web) { return 403; }   # consolas solo por VPN (AP-10)
  }
}
